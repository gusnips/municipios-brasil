{
  // The shared preset holds the lint core. This file adds what the old ESLint config had on top.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@gusnips/oxlint/base.json"],
  "plugins": [],
  // Generated by `bun run dados:atualizar`, so the generator owns their types, not the lint.
  "ignorePatterns": ["**/*.gerado.ts"],
  "rules": {
    // In ESLint's recommended set, and the old config kept it on for TypeScript files too.
    // Outside oxlint's `correctness`.
    "no-redeclare": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": { "typescript/no-empty-object-type": "off" }
    },
    {
      "files": ["scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts"],
      "rules": { "typescript/no-require-imports": "off" }
    }
  ]
}
